NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
OTP_SECRET=optional-separate-otp-secret
FRONTEND_URL=http://localhost:5173,https://your-frontend.vercel.app
AUTH_USE_HTTP_ONLY_COOKIES=false

ADMIN_USERNAME=admin
GROQ_API_KEY=
JUDGE0_BASE_URL=https://ce.judge0.com

# Production recommendation on Render:
# EMAIL_PROVIDER=resend
EMAIL_PROVIDER=resend
EMAIL_FROM=CodeArena 1v1 <onboarding@resend.dev>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Local SMTP fallback only. Do not rely on this on Render.
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
